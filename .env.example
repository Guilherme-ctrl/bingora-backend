# Copy to `.env` and adjust. Never commit real secrets.

DATABASE_URL=postgresql://bingo:bingo@localhost:5432/bingo

JWT_SECRET=change-me-min-16-chars-long
JWT_EXPIRES_IN=3600s

PORT=3000
NODE_ENV=development

# Comma-separated browser origins (scheme + host + port). In production this is required.
# Example: https://app.example.com,https://www.example.com
# Leave unset in development to allow any origin (reflect) for local tools.
# CORS_ORIGINS=http://localhost:5173

# Rollout flag: when true, new sales require an active round in EM_VENDA.
# Keep false during transition to preserve legacy MVP behavior.
# ROUND_FLOW_ENFORCED=false
